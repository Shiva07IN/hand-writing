# ──────────────────────────────────────────────────────────
#  MUJ Assignment Agent - Configuration
# ──────────────────────────────────────────────────────────

# Google Gemini API Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use (gemini-2.0-flash is free tier friendly)
GEMINI_MODEL=gemini-2.0-flash

# ──────────────────────────────────────────────────────────
#  Handwriting Style Settings
# ──────────────────────────────────────────────────────────

# Ink color (R,G,B) - dark blue ballpoint pen look
INK_COLOR_R=15
INK_COLOR_G=25
INK_COLOR_B=105

# Font size for handwriting (default: 38)
FONT_SIZE=38

# Page style: "blank", "lined", "ruled"
PAGE_STYLE=lined

# ──────────────────────────────────────────────────────────
#  Student Info (for assignment headers)
# ──────────────────────────────────────────────────────────
STUDENT_NAME=Your Name
STUDENT_REG_NO=your_registration_number
STUDENT_SECTION=your_section
STUDENT_COURSE=your_course
